# Production — set on Cloudflare Pages (build env) and/or GitHub Actions secrets
VITE_API_BASE=https://zwo-builder-api.your-subdomain.workers.dev

# Public site URL (no trailing slash) — canonical links, Open Graph, sitemap, robots.txt
# Example: https://your-project.pages.dev or your custom domain
# On Cloudflare Pages builds, CF_PAGES_URL is used automatically when this is unset.
VITE_SITE_URL=

# Optional ads: leave unset, or set to "ethical" for EthicalAds (see README)
# VITE_ADS=ethical
# VITE_ETHICAL_ADS_PUBLISHER=your-publisher-id
